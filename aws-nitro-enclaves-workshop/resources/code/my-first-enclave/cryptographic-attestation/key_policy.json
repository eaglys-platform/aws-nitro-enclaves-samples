{
  "Id": "key-consolepolicy-3",
  "Version": "2012-10-17",
  "Statement": [
      {
          "Sid": "Enable IAM User Permissions",
          "Effect": "Allow",
          "Principal": {
              "AWS": "arn:aws:iam::140592727448:root"
          },
          "Action": "kms:*",
          "Resource": "*"
      },
      {
          "Sid": "Enable Development Environment to Encrypt",
          "Effect": "Allow",
          "Principal": {
              "AWS": "arn:aws:sts::140592727448:assumed-role/CodeEditorInstanceBootstrapRole/i-026fbf988a8a7145f"
          },
          "Action": "kms:Encrypt",
          "Resource": "*"
      },
      {
          "Sid": "Enable Development Environment to Decrypt",
          "Effect": "Allow",
          "Principal": {
              "AWS": "arn:aws:sts::140592727448:assumed-role/CodeEditorInstanceBootstrapRole/i-026fbf988a8a7145f"
          },
          "Action": "kms:Decrypt",
          "Resource": "*",
          "Condition": {
              "StringEqualsIgnoreCase": {
                  "kms:RecipientAttestation:PCR0": "0d0b0c5639e8986250a753ff98f4c6cb124d04d24f4ad7018de0c812292b6b8edece4e780b400e265cf209ed4c887479"
              }
          }
      }
  ]
}
